@using MVCStok.Models.Entity
@using PagedList;
@using PagedList.Mvc;
@model  PagedList.IPagedList<TBLKATEGORILER>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<table class="table table-bordered">
    <tr>
        <th>KATEGORİ ID</th>
        <th>KATEGORİ ADI</th>
        <th>SİL</th>
        <th>GÜNCELLE</th>
    </tr>
    <tbody>
        @foreach (var k in Model)
        {
            <tr>
                <th>@k.KATEGORIID</th>
                <td>@k.KATEGORIAD</td>
                <td><a href="/KATEGORI/Sil/@k.KATEGORIID" class="btn btn-danger">SİL</a></td>
                <td><a href="/KATEGORI/KategoriGetir/@k.KATEGORIID" class="btn btn-success">GÜNCELLE</a></td>
            </tr>
        }
    </tbody>
</table>
@Html.PagedListPager((IPagedList)Model,sayfa=>Url.Action("Index",new {sayfa}))

<a href="/KATEGORI/YeniKategori" class="btn btn-primary">YENİ KATEGORİ EKLE</a>
