@using MVCStok.Models.Entity
@model List<TBLURUNLER>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<table id="tbl1" class="table table-bordered">
    <thead>
        <tr>
            <th>ÜRÜN ID</th>
            <th>ÜRÜN ADI</th>
            <th>MARKASI</th>
            <th>KATEGORİ</th>
            <th>FİYAT</th>
            <th>STOK</th>
            <th>SİL</th>
            <th>STOK</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var U in Model)
        {
            <tr>
                <th>@U.URUNID</th>
                <td>@U.URUNAD</td>
                <td>@U.MARKA</td>
                <td>@U.TBLKATEGORILER.KATEGORIAD</td>
                <td>@U.FIYAT</td>
                <td>@U.STOK</td>
                <td><a href="/URUNLER/Sil/@U.URUNID" class="btn btn-danger">SİL</a></td>
                <td><a href="/URUNLER/UrunGetir/@U.URUNID" class="btn btn-success">GÜNCELLE</a></td>

            </tr>
        }
    </tbody>
</table>
<a href="/URUN/UrunEkle" class="btn btn-primary">YENİ ÜRÜN EKLE</a>
<link href="~/Content/DataTables/css/dataTables.bootstrap4.css" rel="stylesheet" />
<script type="text/javascript" src="https://cdn.datatables.net/1.10.22/js/jquery.dataTables.min.js"></script>
<link href="https://cdn.datatables.net/1.10.22/css/jquery.dataTables.min.css" rel="stylesheet" />

<script>
    $('#tbl1').DataTable();
</script>