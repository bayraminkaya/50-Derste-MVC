@using MVCStok.Models.Entity
@model List<TBLMUSTERILER>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

@using (Html.BeginForm("Index","Musteri",FormMethod.Get))
            {
                <p>Aranacak Müşteri Adı : @Html.TextBox("p") <input type="submit" value="Ara" /></p>
                
            }
<table class="table table-bordered">
    <tr>
        <th>MÜŞTERİ ID</th>
        <th>MÜŞTERİ ADI</th>
        <th>MÜŞTERİ SOYADI</th>
        <th>SİL</th>
        <th>GÜNCELLE</th>
        <th>ALERT</th>
    </tr>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <th>@m.MUSTERIID</th>
                <td>@m.MUSTERIAD</td>
                <td>@m.MUSTERISOYAD</td>
                <td><a href="/MUSTERI/Sil/@m.MUSTERIID" class="btn btn-danger">SİL</a></td>
                <td><a href="/MUSTERI/MusteriGetir/@m.MUSTERIID" class="btn btn-success">GÜNCELLE</a></td>
                <td>@Html.ActionLink("SİL BUTONU","SIL",new {id=m.MUSTERIID},new {@class="btn btn-warning",onclick = "return confirm('Gerçekten Silmek İstiyor Musunuz?')"})</td>
            </tr>
        }
    </tbody>
</table>
<a href="/MUSTERI/YeniMusteri" class="btn btn-primary">YENİ MÜŞTERİ EKLE</a>


